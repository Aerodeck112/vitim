# VITIM AI — configurare pentru cPanel. Copiază acest fișier ca .env și completează valorile marcate.
APP_NAME="VITIM AI"
APP_ENV=production
APP_DEBUG=false
# se generează automat la prima rulare a cron-ului (vitim:deploy)
APP_KEY=
# COMPLETEAZĂ: adresa subdomeniului
APP_URL=https://ai.vitim.ro
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro

LOG_CHANNEL=daily
LOG_LEVEL=warning

# COMPLETEAZĂ: din cPanel → MySQL Databases (bază și utilizator DOAR pentru platformă)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# COMPLETEAZĂ: un cont de email din cPanel (ex. noreply@vitim.ro)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.vitim.ro
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@vitim.ro
MAIL_FROM_NAME="VITIM AI"

# COMPLETEAZĂ la instalare (min. 16 caractere aleatorii), apoi ȘTERGE după crearea primului administrator
SETUP_TOKEN=
# COMPLETEAZĂ: adresă din AFARA hostingului (Gmail/Outlook) pentru backup-ul zilnic
BACKUP_EMAIL=
BACKUP_KEEP_LOCAL=7
